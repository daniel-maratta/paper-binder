<Project>
  <PropertyGroup>
    <VersionPrefix>1.1.1</VersionPrefix>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <Authors>Daniel Maratta</Authors>
    <Company>Daniel Maratta</Company>
    <Product>PaperBinder</Product>
    <Description>PaperBinder is a constrained multi-tenant SaaS portfolio demo designed and built by Daniel Maratta.</Description>
    <PackageProjectUrl>https://paperbinder.danielmaratta.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/daniel-maratta/paper-binder.git</RepositoryUrl>
    <Copyright>Copyright © Daniel Maratta</Copyright>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <PaperBinderCoverletCollectorVersion>6.0.4</PaperBinderCoverletCollectorVersion>
    <PaperBinderDapperVersion>2.1.72</PaperBinderDapperVersion>
    <PaperBinderEntityFrameworkCoreDesignVersion>10.0.4</PaperBinderEntityFrameworkCoreDesignVersion>
    <PaperBinderDependencyInjectionAbstractionsVersion>10.0.4</PaperBinderDependencyInjectionAbstractionsVersion>
    <PaperBinderMicrosoftExtensionsIdentityCoreVersion>10.0.4</PaperBinderMicrosoftExtensionsIdentityCoreVersion>
    <PaperBinderHostingVersion>10.0.0</PaperBinderHostingVersion>
    <PaperBinderMicrosoftNetTestSdkVersion>17.14.1</PaperBinderMicrosoftNetTestSdkVersion>
    <PaperBinderNpgsqlVersion>10.0.2</PaperBinderNpgsqlVersion>
    <PaperBinderNpgsqlEntityFrameworkCorePostgreSqlVersion>10.0.1</PaperBinderNpgsqlEntityFrameworkCorePostgreSqlVersion>
    <PaperBinderOpenTelemetryVersion>1.16.0</PaperBinderOpenTelemetryVersion>
    <PaperBinderSshNetVersion>2026.0.0</PaperBinderSshNetVersion>
    <PaperBinderTestcontainersPostgreSqlVersion>4.11.0</PaperBinderTestcontainersPostgreSqlVersion>
    <PaperBinderXunitVersion>2.9.3</PaperBinderXunitVersion>
    <PaperBinderXunitRunnerVisualStudioVersion>3.1.4</PaperBinderXunitRunnerVisualStudioVersion>
  </PropertyGroup>
</Project>
