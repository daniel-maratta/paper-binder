# Wildcard certificates require DNS-01 validation; this Caddyfile expects
# Namecheap API access to be enabled with the droplet IPv4 whitelisted.

(paperbinder-test-tls) {
	tls {
		dns namecheap {
			api_key {$NAMECHEAP_API_KEY}
			user {$NAMECHEAP_API_USER}
			api_endpoint {$NAMECHEAP_API_ENDPOINT:https://api.namecheap.com/xml.response}
			client_ip {$NAMECHEAP_CLIENT_IP}
		}
	}
}

(paperbinder-test-proxy) {
	header {
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	handle /robots.txt {
		root * /srv/paperbinder-test
		file_server
	}

	encode gzip zstd
	reverse_proxy app:8080
}

paperbinder-test.danielmaratta.com {
	import paperbinder-test-tls
	import paperbinder-test-proxy
}

*.paperbinder-test.danielmaratta.com {
	import paperbinder-test-tls
	import paperbinder-test-proxy
}
